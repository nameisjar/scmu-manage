# ===========================
# SCMU Environment Config
# ===========================

# --- Database ---
POSTGRES_DB=scmu
POSTGRES_USER=scmu
POSTGRES_PASSWORD=change_this_strong_password

# --- Backend ---
DATABASE_URL=postgresql://scmu:change_this_strong_password@postgres:5432/scmu
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_EXPIRES_IN=7d
NODE_ENV=production

# --- Frontend ---
VITE_API_URL=http://localhost:5000

# --- URLs ---
FRONTEND_URL=http://localhost:3000
